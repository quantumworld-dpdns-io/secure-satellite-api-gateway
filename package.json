  "description": "> Secure satellite API gateway – normalizes access to telemetry and mission data with fine-grained authorization and lineage tracking",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantumworld-dpdns-io/secure-satellite-api-gateway.git"
  },
  "keywords": [],
